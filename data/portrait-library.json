  "selection_rules": [
    {"id": "identity-first", "zh": "涉及真实人物、客户照片或纪念照片时，优先选择明确锁定身份的记录。", "en": "For real people, client photos, or sentimental images, prefer records with explicit identity control."},
    {"id": "original-language", "zh": "收录提示词按来源原语言输出；不得翻译、润色或假装是新创作。", "en": "Collected prompts are returned in their source language; do not translate, polish, or present them as newly authored."},
